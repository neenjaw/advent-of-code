# frozen_string_literal: true

require "rake"
require "rbconfig"

desc "Run the Advent of Code solution tests"
task :test do
  sh RbConfig.ruby, "-Itest", "test/solution_test.rb", verbose: false
end

desc "Run the solution (optionally set INPUT=path)"
task :run do
  input_path = ENV.fetch("INPUT", "input.txt")
  sh RbConfig.ruby, "run.rb", input_path, verbose: false
end

task default: :test
